# GEMINI_API_KEY: Required for Gemini AI editorial and moderation assist calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PANEL_PASSCODE: Optional server-side passcode to unlock the Admin Panel.
# Leave unset to claim a passcode on first visit via the inline Admin Setup form.
ADMIN_PANEL_PASSCODE=
